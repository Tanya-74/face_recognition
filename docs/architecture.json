  "cards": [
    {
      "dot": "emerald",
      "title": "Offline",
      "items": [
        "Models are read from models/, never from the internet",
        "The page loads no outside fonts, scripts or images"
      ]
    },
    {
      "dot": "cyan",
      "title": "Threshold",
      "items": [
        "Server returns nearest person and distance",
        "The page applies the threshold, so the slider needs no server call"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache",
      "items": [
        "Known-people embeddings stay in memory until restart",
        "Not stored on disk"
      ]
